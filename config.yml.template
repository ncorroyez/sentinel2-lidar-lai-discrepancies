# config.yml.template — copier en config.yml et adapter à votre environnement
#
# Ne PAS versionner config.yml (il est dans .gitignore).
# Ce template est la référence versionnée.
#
# Pour basculer vers le serveur SMB : changer "profile: local" en "profile: smb"
# et ajuster les chemins du bloc smb si votre point de montage diffère.

profile: local   # "local" ou "smb"

profiles:

  # ── Option A : données locales ─────────────────────────────────────────────
  local:
    data_root:   /CHANGER/VERS/NC_Full/revision/data
    output_root: /CHANGER/VERS/NC_Full/revision/output
    dirs:
      raw_data:      raw
      ext_results:   results
      prosail_lidar: prosail_lidar
      prosail_codes: ../../PROSAIL-Optimization/02_CODES

  # ── Option B : serveur INRAE partagé (SMB) ─────────────────────────────────
  # Le point de montage GVfs par défaut sous GNOME Linux :
  #   /run/user/1001/gvfs/smb-share:server=pnas3.stockage.inrae.fr,share=mo-mtd-pulse
  # Adapter si monté autrement (ex : /mnt/pulse ou via autofs).
  smb:
    data_root:   /run/user/1001/gvfs/smb-share:server=pnas3.stockage.inrae.fr,share=mo-mtd-pulse/root/_PROJETS/2023_2026_These_Nathan_Corroyez/NC_Full
    output_root: /run/user/1001/gvfs/smb-share:server=pnas3.stockage.inrae.fr,share=mo-mtd-pulse/root/_PROJETS/2023_2026_These_Nathan_Corroyez/NC_Full/revision/output
    dirs:
      raw_data:      01_DATA
      ext_results:   03_RESULTS
      prosail_lidar: PROSAIL-Optimization/01_DATA
      prosail_codes: PROSAIL-Optimization/02_CODES
