# config.yml.template — copy to config.yml and adapt to your environment.
#
# Do NOT version config.yml (it is in .gitignore).
# This template is the versioned reference.
#
# Most users only need the `local` profile: point data_root to the directory
# where you extracted data_bundle.zip, and output_root to where you want
# intermediate outputs and figures.

profile: local

profiles:

  # ── Default: local data bundle ──────────────────────────────────────────────
  local:
    data_root:   /CHANGE/TO/repo/data
    output_root: /CHANGE/TO/repo/output
    dirs:
      raw_data:      raw
      ext_results:   results
      prosail_lidar: prosail_lidar

  # ── Internal: INRAE SMB share (authors only) ────────────────────────────────
  # Reproduces the full data layout from the originating filesystem.
  smb:
    data_root:   /run/user/1001/gvfs/smb-share:server=pnas3.stockage.inrae.fr,share=mo-mtd-pulse/root/_PROJETS/2023_2026_These_Nathan_Corroyez/NC_Full
    output_root: /CHANGE/TO/repo/output
    dirs:
      raw_data:      01_DATA
      ext_results:   03_RESULTS
      prosail_lidar: PROSAIL-Optimization/01_DATA
